NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
CONVEX_HTTP_URL=
# Set this same random 32+ character value in Next.js AND Convex.
WALL_SERVER_SECRET=
# Separate stable 32+ character secret for hashing and signed event contexts (Next.js).
WALL_TOKEN_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional existing fixed USD 399-cent one-time price; otherwise inline server price is used.
STRIPE_PRICE_ID=
# Both Next.js and Convex; must match Stripe keys and deployment isolation.
WALL_ENVIRONMENT=test
# Convex only, with a TakeTheWall-verified sender.
RESEND_API_KEY=
RESEND_FROM=
# Actual public site key format vp_XXXXXXXX, not a private API key.
VISITORPING_SITE_KEY=
# Convex only: private, site-scoped Analytics API key and website ID from /api/v1/sites.
# This ID is different from the public vp_XXXXXXXX ingestion key above.
VISITORPING_API_KEY=
VISITORPING_SITE_ID=
# Vercel build only: deployment key for the correct Convex environment.
CONVEX_DEPLOY_KEY=
# Only set true on a dedicated production deployment after launch checks.
PUBLIC_METRICS_ENABLED=false
# Comma-separated known malicious domains to reject before payment.
BLOCKED_DOMAINS=

# Better Auth: public Convex HTTP origin and matching server origin.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Convex only: stable random secrets, at least 32 characters each.
BETTER_AUTH_SECRET=
CLAIM_TOKEN_SECRET=
SITE_URL=http://localhost:3000
# Convex only: verified admin emails; empty denies all admin sign-ins.
ADMIN_EMAILS=
ADMIN_USER_IDS=
# Convex only: independent launch controls, all default off.
MILESTONE_REWARDS_ENABLED=false
MILESTONE_PAYOUTS_ENABLED=false
MILESTONE_PUBLIC_PROMOTION_ENABLED=false
AUDIT_ANCHORING_ENABLED=false
